---
import "../styles/reset.astro";
import "../styles/global.astro";

import BgGrid from "../components/bg-grid.astro";
import Navigation from "../components/navigation.astro";
import Embed from "../components/embed.astro";
import Footer from "../components/footer.astro";
---

<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>404 - Page Not Found | Fox Box Insurance</title>
		<Embed />
	</head>
	<body>
		<div class="bg-grid-fixed">
			<BgGrid />
		</div>

		<Navigation />

		<section class="error-section">
			<div class="error-container">
				<div class="error-code-wrapper">
					<div class="error-code">404</div>
					<div class="error-glow"></div>
				</div>

				<h1 class="error-title">Page Not Found</h1>
				<p class="error-description">
					This page doesn't exist, but we logged every detail anyway.
				</p>

				<div class="error-actions">
					<a href="/" class="error-button error-button-primary">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
							<polyline points="9 22 9 12 15 12 15 22"></polyline>
						</svg>
						Return Home
					</a>
					<a href="/support" class="error-button error-button-secondary">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 512" width="14" height="14" fill="currentColor">
							<path d="M524.531,69.836a1.5,1.5,0,0,0-.764-.7A485.065,485.065,0,0,0,404.081,32.03a1.816,1.816,0,0,0-1.923.91,337.461,337.461,0,0,0-14.9,30.6,447.848,447.848,0,0,0-134.426,0,309.541,309.541,0,0,0-15.135-30.6,1.89,1.89,0,0,0-1.924-.91A483.689,483.689,0,0,0,116.085,69.137a1.712,1.712,0,0,0-.788.676C39.068,183.651,18.186,294.69,28.43,404.354a2.016,2.016,0,0,0,.765,1.375A487.666,487.666,0,0,0,176.02,479.918a1.9,1.9,0,0,0,2.063-.676A348.2,348.2,0,0,0,208.12,430.4a1.86,1.86,0,0,0-1.019-2.588,321.173,321.173,0,0,1-45.868-21.853,1.885,1.885,0,0,1-.185-3.126c3.082-2.309,6.166-4.711,9.109-7.137a1.819,1.819,0,0,1,1.9-.256c96.229,43.917,200.41,43.917,295.5,0a1.812,1.812,0,0,1,1.924.233c2.944,2.426,6.027,4.851,9.132,7.16a1.884,1.884,0,0,1-.162,3.126,301.407,301.407,0,0,1-45.89,21.83,1.875,1.875,0,0,0-1,2.611,391.055,391.055,0,0,0,30.014,48.815,1.864,1.864,0,0,0,2.063.7A486.048,486.048,0,0,0,610.7,405.729a1.882,1.882,0,0,0,.765-1.352C623.729,277.594,590.933,167.465,524.531,69.836ZM222.491,337.58c-28.972,0-52.844-26.587-52.844-59.239S193.056,219.1,222.491,219.1c29.665,0,53.306,26.82,52.843,59.239C275.334,310.993,251.924,337.58,222.491,337.58Zm195.38,0c-28.971,0-52.843-26.587-52.843-59.239S388.437,219.1,417.871,219.1c29.667,0,53.307,26.82,52.844,59.239C470.715,310.993,447.538,337.58,417.871,337.58Z" />
						</svg>
						Support
					</a>
				</div>
			</div>
		</section>

		<Footer />

		<script>
			document.addEventListener('DOMContentLoaded', () => {
				const errorCode = document.querySelector('.error-code');
				if (errorCode) {
					errorCode.style.animation = 'float 3s ease-in-out infinite';
				}
			});
		</script>
	</body>
</html>

<style is:global>
	*, *::before, *::after {
		box-sizing: border-box;
	}

	.bg-grid-fixed {
		position: fixed;
		inset: 0;
		z-index: 0;
		pointer-events: none;
	}

	.bg-grid-fixed > * {
		position: absolute !important;
		inset: 0 !important;
		width: 100% !important;
		height: 100% !important;
	}

	body {
		position: relative;
		z-index: 1;
	}

	.error-section {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 100vh;
		padding: 2rem 1.5rem;
		position: relative;
		z-index: 1;
	}

	.error-container {
		max-width: 600px;
		width: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
		text-align: center;
	}

	.error-code-wrapper {
		position: relative;
		margin-bottom: 1rem;
	}

	.error-code {
		font-size: 6rem;
		font-weight: 900;
		letter-spacing: -0.06em;
		background: linear-gradient(135deg, rgba(255, 72, 0, 0.8), rgba(255, 72, 0, 0.4));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		line-height: 1;
		animation: float 3s ease-in-out infinite;
	}

	@keyframes float {
		0%, 100% { transform: translateY(0px); }
		50% { transform: translateY(-10px); }
	}

	.error-glow {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: 300px;
		height: 300px;
		background: radial-gradient(circle, rgba(255, 72, 0, 0.15) 0%, transparent 70%);
		border-radius: 50%;
		filter: blur(40px);
		pointer-events: none;
	}

	.error-title {
		font-size: 2.5rem;
		font-weight: 800;
		letter-spacing: -0.04em;
		margin-bottom: 0.75rem;
		line-height: 1.2;
	}

	.error-description {
		color: rgba(209, 213, 219, 0.7);
		font-size: 0.95rem;
		line-height: 1.6;
		max-width: 400px;
		margin-bottom: 1.5rem;
	}

	.error-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		justify-content: center;
	}

	.error-button {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-weight: 600;
		padding: 0.7rem 1.75rem;
		border-radius: 0.75rem;
		transition: all 0.15s ease;
		font-size: 0.9rem;
		text-decoration: none;
		letter-spacing: -0.01em;
	}

	.error-button-primary {
		background: rgba(255, 72, 0, 0.15);
		border: 1px solid rgba(255, 72, 0, 0.45);
		color: #fff;
	}

	.error-button-primary:hover {
		background: rgba(255, 72, 0, 0.25);
		border-color: rgba(255, 72, 0, 0.75);
		transform: translateY(-2px);
	}

	.error-button-secondary {
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid rgba(255, 255, 255, 0.1);
		color: rgba(255, 255, 255, 0.75);
	}

	.error-button-secondary:hover {
		background: rgba(255, 255, 255, 0.08);
		border-color: rgba(255, 255, 255, 0.2);
		color: #fff;
		transform: translateY(-2px);
	}



	@media (min-width: 480px) {
		.error-title {
			font-size: 3rem;
		}

		.error-code {
			font-size: 7rem;
		}
	}

	@media (min-width: 640px) {
		.error-title {
			font-size: 3.5rem;
		}

		.error-code {
			font-size: 8rem;
		}

		.error-description {
			font-size: 1.05rem;
		}
	}
</style>