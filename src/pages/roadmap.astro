---
import "../styles/reset.astro";
import "../styles/global.astro";

import BgGrid from "../components/bg-grid.astro";
import Navigation from "../components/navigation.astro";
import Embed from "../components/embed.astro";
import Footer from "../components/footer.astro";

const roadmapPhases = [
	//{
	//	id: 1,
	//	quarter: "Q4 2024",
	//	dateRange: "October - December 2024",
	//	status: "completed",
	//	statusLabel: "Completed",
	//	features: [
	//		{
	//			title: "Core Message Logging",
	//			description: "Complete message history with timestamps and metadata"
	//		},
	//		{
	//			title: "Attachment & Embed Preservation",
	//			description: "Full capture of media and embedded content"
	//		},
	//		{
	//			title: "Encrypted Storage",
	//			description: "Military-grade encryption for all data at rest"
	//		}
	//	]
	//},
];

function getStatusIcon(status: string) {
	switch(status) {
		case "completed":
			return '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';
		case "in-progress":
			return '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"></circle><path d="M12 1v6m0 6v6"></path></svg>';
		case "planned":
			return '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"></path><path d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>';
		case "future":
			return '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path><polyline points="13 2 13 9 20 9"></polyline></svg>';
		default:
			return '';
	}
}

function getFeatureIcon() {
	return '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';
}
---
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Roadmap - Fox Box Insurance</title>
		<Embed />
	</head>
	<body>

		<div class="bg-grid-fixed">
			<BgGrid />
		</div>
		<Navigation />

		<section class="roadmap-hero">
			<div class="roadmap-hero-container">
				<h1 class="roadmap-hero-title">Our Roadmap</h1>
				<p class="roadmap-hero-description">
					See what's coming next for Fox Box Insurance. We're constantly building and improving to keep your Discord communities safe.
				</p>
			</div>
		</section>

		<div class="roadmap-section">
			<div class="roadmap-container">
				{roadmapPhases.length > 0 ? (
					<div class="roadmap-timeline">
						{roadmapPhases.map((phase, index) => (
							<div class="roadmap-phase" style={`animation-delay: ${(index + 1) * 0.1}s`}>
								<div class={`phase-header ${phase.status}`}>
									<div class="phase-status-badge">
										<Fragment set:html={getStatusIcon(phase.status)} />
										{phase.statusLabel}
									</div>
									<h2 class="phase-title">{phase.quarter}</h2>
									<p class="phase-date">{phase.dateRange}</p>
								</div>
								<div class="phase-features">
									{phase.features.map((feature) => (
										<div class={`feature-item ${phase.status}`}>
											<Fragment set:html={getFeatureIcon()} />
											<div>
												<h3>{feature.title}</h3>
												<p>{feature.description}</p>
											</div>
										</div>
									))}
								</div>
							</div>
						))}
					</div>
				) : (
					<div class="empty-state">
						<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path>
							<polyline points="13 2 13 9 20 9"></polyline>
						</svg>
						<h2>There's no upcoming roadmap available yet</h2>
						<p>Check back soon for exciting updates!</p>
					</div>
				)}
			</div>
		</div>

		<div class="roadmap-cta">
			<div class="roadmap-cta-container">
				<div class="roadmap-cta-box">
					<h2 class="roadmap-cta-title">Have Ideas?</h2>
					<p class="roadmap-cta-description">
						We love hearing from our community. Have a feature request or suggestion? Join our support server and let us know!
					</p>
					<a href="/support" class="roadmap-cta-button">
						Join Support Server
					</a>
				</div>
			</div>
		</div>

		<Footer />

		<script>
			window.addEventListener('DOMContentLoaded', () => {
				const phases = document.querySelectorAll('.roadmap-phase');
				const observer = new IntersectionObserver((entries) => {
					entries.forEach(entry => {
						if (entry.isIntersecting) {
							entry.target.classList.add('visible');
						}
					});
				}, { threshold: 0.1 });

				phases.forEach(phase => observer.observe(phase));
			});
		</script>
	</body>
</html>

<style is:global>
	.roadmap-hero {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 50vh;
		padding: 6rem 1.5rem 4rem;
		position: relative;
		z-index: 1;
		text-align: center;
	}

	.roadmap-hero-container {
		max-width: 700px;
		margin: 0 auto;
	}

	.roadmap-hero-title {
		font-size: 3rem;
		font-weight: 800;
		margin-bottom: 1rem;
		letter-spacing: -0.04em;
		line-height: 1.1;
	}

	.roadmap-hero-description {
		color: rgba(209, 213, 219, 0.65);
		font-size: 1.05rem;
		line-height: 1.75;
	}

	.roadmap-section {
		padding: 0 1.5rem 6rem;
		margin-top: -3rem;
		position: relative;
		z-index: 1;
	}

	.roadmap-container {
		max-width: 900px;
		margin: 0 auto;
	}

	.roadmap-timeline {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.empty-state {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		padding: 3rem 2rem;
		background: #141418;
		border: 1px solid rgba(255, 255, 255, 0.06);
		border-radius: 1.25rem;
		border-style: dashed;
	}

	.empty-state svg {
		color: rgba(255, 72, 0, 0.3);
		margin-bottom: 1.5rem;
	}

	.empty-state h2 {
		font-size: 1.5rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		margin-bottom: 0.5rem;
		color: rgba(209, 213, 219, 0.85);
	}

	.empty-state p {
		color: rgba(209, 213, 219, 0.45);
		font-size: 0.95rem;
	}

	.roadmap-phase {
		background: #141418;
		border: 1px solid rgba(255, 255, 255, 0.06);
		border-radius: 1.25rem;
		padding: 2rem;
		transition: all 0.3s ease;
		opacity: 0;
		animation: fadeIn 0.6s ease forwards;
	}

	.roadmap-phase.visible {
		opacity: 1;
	}

	@keyframes fadeIn {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.roadmap-phase:nth-child(1) { animation-delay: 0.1s; }
	.roadmap-phase:nth-child(2) { animation-delay: 0.2s; }
	.roadmap-phase:nth-child(3) { animation-delay: 0.3s; }
	.roadmap-phase:nth-child(4) { animation-delay: 0.4s; }
	.roadmap-phase:nth-child(5) { animation-delay: 0.5s; }

	.phase-header {
		margin-bottom: 2rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.05);
	}

	.phase-status-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.75rem;
		font-weight: 600;
		padding: 0.4rem 0.8rem;
		border-radius: 0.5rem;
		margin-bottom: 1rem;
	}

	.phase-header.completed .phase-status-badge {
		background: rgba(16, 185, 129, 0.1);
		color: #10b981;
		border: 1px solid rgba(16, 185, 129, 0.2);
	}

	.phase-header.in-progress .phase-status-badge {
		background: rgba(255, 72, 0, 0.15);
		color: #ff4800;
		border: 1px solid rgba(255, 72, 0, 0.3);
	}

	.phase-header.planned .phase-status-badge {
		background: rgba(59, 130, 246, 0.1);
		color: #3b82f6;
		border: 1px solid rgba(59, 130, 246, 0.2);
	}

	.phase-header.future .phase-status-badge {
		background: rgba(168, 85, 247, 0.1);
		color: #a855f7;
		border: 1px solid rgba(168, 85, 247, 0.2);
	}

	.phase-title {
		font-size: 1.75rem;
		font-weight: 800;
		letter-spacing: -0.03em;
		margin-bottom: 0.25rem;
	}

	.phase-date {
		color: rgba(209, 213, 219, 0.45);
		font-size: 0.875rem;
	}

	.phase-features {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.feature-item {
		display: flex;
		gap: 1rem;
		align-items: flex-start;
		padding: 1rem;
		border-radius: 0.75rem;
		transition: background 0.2s ease;
	}

	.feature-item.completed {
		background: rgba(16, 185, 129, 0.05);
	}

	.feature-item.in-progress {
		background: rgba(255, 72, 0, 0.05);
	}

	.feature-item.planned {
		background: rgba(59, 130, 246, 0.05);
	}

	.feature-item.future {
		background: rgba(168, 85, 247, 0.05);
	}

	.feature-item:hover {
		background: rgba(255, 255, 255, 0.05);
	}

	.feature-icon {
		flex-shrink: 0;
		margin-top: 0.2rem;
	}

	.feature-item.completed .feature-icon {
		color: #10b981;
	}

	.feature-item.in-progress .feature-icon {
		color: #ff4800;
	}

	.feature-item.planned .feature-icon {
		color: #3b82f6;
	}

	.feature-item.future .feature-icon {
		color: #a855f7;
	}

	.feature-item h3 {
		font-size: 1rem;
		font-weight: 700;
		margin-bottom: 0.25rem;
		letter-spacing: -0.02em;
	}

	.feature-item p {
		color: rgba(209, 213, 219, 0.65);
		font-size: 0.875rem;
		margin: 0;
	}

	.roadmap-cta {
		padding: 6rem 1.5rem;
		border-top: 1px solid rgba(255, 255, 255, 0.05);
		position: relative;
		z-index: 1;
	}

	.roadmap-cta-container {
		max-width: 1152px;
		margin: 0 auto;
	}

	.roadmap-cta-box {
		background: #141418;
		border: 1px solid rgba(255, 72, 0, 0.18);
		border-radius: 1.5rem;
		padding: 3rem 2rem;
		text-align: center;
		max-width: 560px;
		margin: 0 auto;
	}

	.roadmap-cta-title {
		font-size: 1.75rem;
		font-weight: 800;
		letter-spacing: -0.04em;
		margin-bottom: 0.75rem;
	}

	.roadmap-cta-description {
		color: rgba(209, 213, 219, 0.65);
		margin-bottom: 1.5rem;
		line-height: 1.75;
		font-size: 0.95rem;
	}

	.roadmap-cta-button {
		display: inline-flex;
		align-items: center;
		background: rgba(255, 72, 0, 0.15);
		border: 1px solid rgba(255, 72, 0, 0.45);
		color: #fff;
		font-weight: 600;
		font-size: 0.9rem;
		padding: 0.7rem 1.75rem;
		border-radius: 0.625rem;
		text-decoration: none;
		transition: all 0.15s ease;
		letter-spacing: -0.01em;
	}

	.roadmap-cta-button:hover {
		background: rgba(255, 72, 0, 0.25);
		border-color: rgba(255, 72, 0, 0.75);
	}

	@media (min-width: 640px) {
		.roadmap-hero-title {
			font-size: 3.5rem;
		}

		.phase-title {
			font-size: 2rem;
		}
	}

	@media (min-width: 1024px) {
		.roadmap-hero-title {
			font-size: 4rem;
		}
	}
</style>