---
import "../styles/reset.astro";
import "../styles/global.astro";

import BgGrid from "../components/bg-grid.astro";
import Navigation from "../components/navigation.astro";
import Embed from "../components/embed.astro";
import Footer from "../components/footer.astro";
import logoAnimation from "../assets/logo-animation.mp4";
---
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Fox Box Insurance</title>
		<Embed />
	</head>
	<body>

		<div class="bg-grid-fixed">
			<BgGrid />
		</div>
		<Navigation />

		<section class="hero-section">
			<div class="hero-container">
				<div class="hero-content">
					<h1 class="hero-title">
						You'll forget about it.<br><span class="hero-accent">We won't.</span>
					</h1>
					<p class="hero-description">
						Fox Box Insurance delivers unmatched moderation and security, logging every detail so your community stays safe -
						even when no one's watching.
					</p>
					<div class="hero-buttons">
						<a href="/invite" class="btn btn-primary">
							<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
								<path d="M5 12h14"></path>
								<path d="M12 5v14"></path>
							</svg>
							Add Bot
						</a>
						<a href="/support" class="btn btn-secondary">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 512" width="14" height="14" fill="currentColor">
								<path d="M524.531,69.836a1.5,1.5,0,0,0-.764-.7A485.065,485.065,0,0,0,404.081,32.03a1.816,1.816,0,0,0-1.923.91,337.461,337.461,0,0,0-14.9,30.6,447.848,447.848,0,0,0-134.426,0,309.541,309.541,0,0,0-15.135-30.6,1.89,1.89,0,0,0-1.924-.91A483.689,483.689,0,0,0,116.085,69.137a1.712,1.712,0,0,0-.788.676C39.068,183.651,18.186,294.69,28.43,404.354a2.016,2.016,0,0,0,.765,1.375A487.666,487.666,0,0,0,176.02,479.918a1.9,1.9,0,0,0,2.063-.676A348.2,348.2,0,0,0,208.12,430.4a1.86,1.86,0,0,0-1.019-2.588,321.173,321.173,0,0,1-45.868-21.853,1.885,1.885,0,0,1-.185-3.126c3.082-2.309,6.166-4.711,9.109-7.137a1.819,1.819,0,0,1,1.9-.256c96.229,43.917,200.41,43.917,295.5,0a1.812,1.812,0,0,1,1.924.233c2.944,2.426,6.027,4.851,9.132,7.16a1.884,1.884,0,0,1-.162,3.126,301.407,301.407,0,0,1-45.89,21.83,1.875,1.875,0,0,0-1,2.611,391.055,391.055,0,0,0,30.014,48.815,1.864,1.864,0,0,0,2.063.7A486.048,486.048,0,0,0,610.7,405.729a1.882,1.882,0,0,0,.765-1.352C623.729,277.594,590.933,167.465,524.531,69.836ZM222.491,337.58c-28.972,0-52.844-26.587-52.844-59.239S193.056,219.1,222.491,219.1c29.665,0,53.306,26.82,52.843,59.239C275.334,310.993,251.924,337.58,222.491,337.58Zm195.38,0c-28.971,0-52.843-26.587-52.843-59.239S388.437,219.1,417.871,219.1c29.667,0,53.307,26.82,52.844,59.239C470.715,310.993,447.538,337.58,417.871,337.58Z" />
							</svg>
							Support Server
						</a>
					</div>
				</div>
				<div class="hero-image-container">
					<img src="/fucker.jpeg" alt="fox" class="hero-image" />
				</div>
			</div>
		</section>

		<div class="about-section">
			<div class="about-container">
				<div class="about-header">
					<h2 class="about-title">About Fox Box Insurance</h2>
					<p class="about-subtitle">Who we are and why we built this</p>
				</div>

				<div class="about-grid">
					<div class="about-card">
						<div class="about-card-icon">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
								<circle cx="12" cy="7" r="4"></circle>
							</svg>
						</div>
						<h3 class="about-card-title">The Team</h3>
						<p class="about-card-description">
							Fox Box Insurance is built by the one and only musicmaker. We understand the challenges that server administrators face in maintaining safe, vibrant communities.
						</p>
					</div>

					<div class="about-card">
						<div class="about-card-icon">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"></path>
								<polyline points="12 6 12 12 16 14"></polyline>
							</svg>
						</div>
						<h3 class="about-card-title">Our Mission</h3>
						<p class="about-card-description">
							To provide Discord communities with excellent security and logging tools that are simple to use, completely free, and built with privacy at their core. We believe every server deserves high-quality protection.
						</p>
					</div>

					<div class="about-card">
						<div class="about-card-icon">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M12 2L15.09 8.26H22L17.45 12.5L19.54 18.76L12 14.51L4.46 18.76L6.55 12.5L2 8.26H8.91L12 2Z"></path>
							</svg>
						</div>
						<h3 class="about-card-title">Why We Built This</h3>
						<p class="about-card-description">
							We saw too many communities lose everything to raids, accidental deletions, and rogue administrators. Existing solutions were expensive, complex, or compromised on privacy. So we built FBI- a bot that works silently in the background with zero compromise on security or ethics.
						</p>
					</div>
				</div>

				<div class="about-philosophy">
					<div class="philosophy-content">
						<h3 class="philosophy-title">Our Philosophy</h3>
						<div class="philosophy-points">
							<div class="philosophy-point">
								<div class="philosophy-point-number">01</div>
								<div class="philosophy-point-content">
									<h4>Privacy First</h4>
									<p>Your data belongs to you. We don't sell it, analyze it for profit, or use it for AI training. Period.</p>
								</div>
							</div>
							<div class="philosophy-point">
								<div class="philosophy-point-number">02</div>
								<div class="philosophy-point-content">
									<h4>Open & Transparent</h4>
									<p>Our backend is open source. Our terms are clear. We believe in radical transparency because trust isn't built on secrets.</p>
								</div>
							</div>
							<div class="philosophy-point">
								<div class="philosophy-point-number">03</div>
								<div class="philosophy-point-content">
									<h4>Free & Accessible</h4>
									<p>High-quality security shouldn't require a premium subscription. Essential features are free for every community, no matter the size.</p>
								</div>
							</div>
							<div class="philosophy-point">
								<div class="philosophy-point-number">04</div>
								<div class="philosophy-point-content">
									<h4>Silent Guardian</h4>
									<p>We don't spam your chat. We don't demand attention. We protect quietly and let your community shine.</p>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>

		<div class="stats-section">
			<div class="stats-container">
				<div class="stats-grid">
					<div class="stat-card">
						<div class="stat-icon-wrap">
							<svg xmlns="http://www.w3.org/2000/svg" class="stat-icon" viewBox="0 0 24 24">
								<rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
								<rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
								<line x1="6" y1="6" x2="6.01" y2="6"></line>
								<line x1="6" y1="18" x2="6.01" y2="18"></line>
							</svg>
						</div>
						<span id="stats-guilds" class="stat-value">-</span>
						<span class="stat-label">Servers</span>
					</div>
					<div class="stat-card">
						<div class="stat-icon-wrap">
							<svg xmlns="http://www.w3.org/2000/svg" class="stat-icon" viewBox="0 0 24 24">
								<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
								<circle cx="9" cy="7" r="4"></circle>
								<path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
								<path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
							</svg>
						</div>
						<span id="stats-users" class="stat-value">-</span>
						<span class="stat-label">Users</span>
					</div>
					<div class="stat-card">
						<div class="stat-icon-wrap">
							<svg xmlns="http://www.w3.org/2000/svg" class="stat-icon" viewBox="0 0 24 24">
								<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
							</svg>
						</div>
						<span id="stats-messages" class="stat-value">-</span>
						<span class="stat-label">Messages Encrypted</span>
					</div>
					<div class="stat-card">
						<div class="stat-icon-wrap">
							<svg xmlns="http://www.w3.org/2000/svg" class="stat-icon" viewBox="0 0 24 24">
								<path d="M21.96 13.4199C21.8233 12.3214 21.326 11.2993 20.546 10.5139C19.766 9.72844 18.7474 9.22406 17.65 9.07977C17.1768 7.75468 16.2529 6.63824 15.0399 5.92523C13.8269 5.21223 12.4019 4.94801 11.0139 5.17914C9.62597 5.41026 8.36341 6.12202 7.4469 7.18964C6.53039 8.25726 6.01826 9.61302 6 11.02C4.93913 11.02 3.92172 11.4412 3.17157 12.1913C2.42142 12.9415 2 13.9591 2 15.02C2 16.0808 2.42142 17.0982 3.17157 17.8483C3.92172 18.5985 4.93913 19.02 6 19.02H12"/>
								<path d="M18.7793 15V23"/>
								<path d="M21.98 19.8L18.7801 23L15.5801 19.8"/>
							</svg>
						</div>
						<span id="stats-snapshots" class="stat-value">-</span>
						<span class="stat-label">Snapshots</span>
					</div>
				</div>
			</div>
		</div>

		<div class="comparison-section">
			<div class="comparison-container">
				<h2 class="comparison-title">Why Fox Box Insurance?</h2>
				<p class="comparison-description">
					FBI is not built like other bots - we take security and privacy seriously right out the gate.
					Built to record and protect silently from the shadows; you won't even know it's there.
				</p>
				<div class="table-wrapper">
					<table class="comparison-table">
						<thead>
							<tr class="table-header-row">
								<th class="table-header">Feature</th>
								<th class="table-header">Most Bots</th>
								<th class="table-header fbi-col">
									<span class="fbi-col-label">FBI</span>
								</th>
							</tr>
						</thead>
						<tbody>
							<tr class="table-row">
								<td class="table-cell table-cell-feature">Message Logging</td>
								<td class="table-cell">
									<div class="feature-status">
										<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon-check"><polyline points="20 6 9 17 4 12"></polyline></svg>
										Basic messages
									</div>
								</td>
								<td class="table-cell fbi-col">
									<div class="feature-status">
										<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon-primary"><polyline points="20 6 9 17 4 12"></polyline></svg>
										Full messages, attachments & embeds
									</div>
								</td>
							</tr>
							<tr class="table-row">
								<td class="table-cell table-cell-feature">Embeds & Attachments</td>
								<td class="table-cell">
									<div class="feature-status">
										<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon-warning"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
										Often skipped or limited
									</div>
								</td>
								<td class="table-cell fbi-col">
									<div class="feature-status">
										<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon-primary"><polyline points="20 6 9 17 4 12"></polyline></svg>
										Fully captured & archived
									</div>
								</td>
							</tr>
							<tr class="table-row">
								<td class="table-cell table-cell-feature">Channel Recovery</td>
								<td class="table-cell">
									<div class="feature-status">
										<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon-x"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
										Not available
									</div>
								</td>
								<td class="table-cell fbi-col">
									<div class="feature-status">
										<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon-primary"><polyline points="20 6 9 17 4 12"></polyline></svg>
										Up to 10,000 messages
									</div>
								</td>
							</tr>
							<tr class="table-row">
								<td class="table-cell table-cell-feature">Export Options</td>
								<td class="table-cell">
									<div class="feature-status">
										<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon-x"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
										Paid only
									</div>
								</td>
								<td class="table-cell fbi-col">
									<div class="feature-status">
										<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon-primary"><polyline points="20 6 9 17 4 12"></polyline></svg>
										Free exports in multiple formats
									</div>
								</td>
							</tr>
							<tr class="table-row">
								<td class="table-cell table-cell-feature">Privacy</td>
								<td class="table-cell">
									<div class="feature-status">
										<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon-x"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
										Vague data use
									</div>
								</td>
								<td class="table-cell fbi-col">
									<div class="feature-status">
										<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon-primary"><polyline points="20 6 9 17 4 12"></polyline></svg>
										Clear policy & open backend
									</div>
								</td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>
		</div>

		<div class="features-section">
			<div class="features-container">
				<h2 class="features-title">Features</h2>

				<div class="feature-card">
					<div class="feature-image-container">
						<img src="/shield_security.png" alt="Security icon" class="feature-image" />
					</div>
					<div class="feature-content">
						<h3 class="feature-heading">Unrivaled Security</h3>
						<p class="feature-description">
							Fox Box Insurance doesn't mess around when it comes to security. We treat your data like the classified intel that it is. Every message is securely
							stored and encrypted, ensuring that even if someone tries to breach our defenses, your information remains safe and sound. With FBI,
							you can rest easy knowing that your server's history is locked down tighter than Fort Knox.
						</p>
					</div>
				</div>

				<div class="feature-card reverse">
					<div class="feature-image-container">
						<img src="/cloud.png" alt="Moderation icon" class="feature-image" />
					</div>
					<div class="feature-content">
						<h3 class="feature-heading">Effortless Exports</h3>
						<p class="feature-description">
							Fox Box Insurance gives you the power to export entire server histories in just a few clicks. Whether it's for
							record-keeping, audits, or peace of mind, export everything in formats like JSON, HTML, or CSV -
							all at your convenience.
						</p>
					</div>
				</div>

				<div class="feature-card">
					<div class="feature-image-container">
						<img src="/history.png" alt="Commands icon" class="feature-image" />
					</div>
					<div class="feature-content">
						<h3 class="feature-heading">Server Snapshots</h3>
						<p class="feature-description">
							Fox Box Insurance creates occasional server backups for your safety. If things go south - rouge admin, nuke bot, or accidental deletion -
							you can restore your server to a previous state with ease. It's like having a time machine for your Discord server.
							Better yet, it's free, so why wait?
						</p>
					</div>
				</div>
			</div>
		</div>

		<div class="security-section">
			<div class="security-container">
				<div class="security-content">
					<div class="security-image-wrapper">
						<img id="logoImage" src="/logo.png" alt="Lock icon" class="security-image security-image-clickable" />
						<video id="logoVideo" class="security-image security-image-video" style="display: none;" muted playsinline src={logoAnimation}></video>
					</div>
					<div class="security-text">
						<h3 class="security-title">Private by Design</h3>
						<p class="security-description">
							Fox Box Insurance doesn't need the spotlight to keep your server safe. It operates silently in the background
							- no clutter, no noise, no overreach. You stay in control at all times with your data locked
							down and your privacy baked in from the start. <strong>No tracking, no selling, no surprises.</strong>
							<br><br>
							We design around your privacy from the start. Encrypted storage, limited
							permissions, every feature is built to respect your boundaries. We collect only
							what's absolutely necessary, and even that stays under your command. Because real protection
							doesn't shout - it listens, guards, and disappears when you need it to.
						</p>
					</div>
				</div>
			</div>
		</div>

		<div class="cta-section">
			<div class="cta-container">
				<div class="cta-inner">
					<h2 class="cta-title">Get started with Fox Box Insurance today</h2>
					<p class="cta-description">
						Adding FBI to your server is simple and free. Join thousands of Discord communities who trust us
						with their security.
					</p>
					<div class="cta-actions">
						<a href="/invite" class="cta-button-primary">
							Add to Discord
						</a>
						<a href="/support" class="cta-button-ghost">
							Learn more
						</a>
					</div>
				</div>
			</div>
		</div>

		<Footer />

		<script>
			const POWERS = ['K', 'M', 'B', 'T', 'Qa', 'Qi', 'Sx', 'Sp', 'Oc', 'No'];
			function SmartRound(input: number): string {
				input = Math.abs(input);
				if (input < 1000) return input.toString();
				const power = ~~(Math.log10(input) / 3);
				const symbol = POWERS[power - 1];
				const value = Math.round(input / Math.pow(1000, power));
				return `${value}${symbol}`;
			}

			async function fetchStats() {
				try {
					const response = await fetch('https://api.notfbi.dev/stats');
					const data = await response.json() as { guilds: number, users: number, messages: number, snapshots: number }
					document.getElementById('stats-guilds')!.textContent    = data.guilds    ? SmartRound(data.guilds)    : 'N/A';
					document.getElementById('stats-users')!.textContent     = data.users     ? SmartRound(data.users)     : 'N/A';
					document.getElementById('stats-messages')!.textContent  = data.messages  ? SmartRound(data.messages)  : 'N/A';
					document.getElementById('stats-snapshots')!.textContent = data.snapshots ? SmartRound(data.snapshots) : 'N/A';
				} catch (error) {
					console.log(error);
				}
			}

			window.addEventListener('DOMContentLoaded', fetchStats);

			// Logo animation interaction
			window.addEventListener('DOMContentLoaded', () => {
				const logoImage = document.getElementById('logoImage') as HTMLImageElement;
				const logoVideo = document.getElementById('logoVideo') as HTMLVideoElement;

				if (logoImage && logoVideo) {
					logoImage.addEventListener('click', () => {
						// Show video and hide image
						logoImage.style.opacity = '0';
						logoImage.style.pointerEvents = 'none';
						logoVideo.style.display = 'block';
						logoVideo.style.opacity = '1';
						
						// Play video
						logoVideo.play();
					});

					// When video ends, fade back to image
					logoVideo.addEventListener('ended', () => {
						logoVideo.style.opacity = '0';
						logoVideo.style.pointerEvents = 'none';
						logoImage.style.opacity = '1';
