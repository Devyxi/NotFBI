		background: rgba(13, 13, 16, 0.72);
		border: 1px solid var(--line);
		border-radius: 999px;
		z-index: 100;
		gap: 1.25rem;
		font-family: system-ui, -apple-system, sans-serif;
	}

	nav a {
		color: var(--bright);
		text-decoration: none;
	}

	.navbar-brand {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		flex-shrink: 0;
	}

	.logo-img {
		border-radius: 999px;
		display: block;
		flex-shrink: 0;
	}

	.brand-text {
		display: flex;
		flex-direction: column;
		gap: 0.06rem;
	}

	.brand-name {
		font-size: 0.9rem;
		font-weight: 700;
		color: var(--bright);
		letter-spacing: -0.025em;
		white-space: nowrap;
		line-height: 1.2;
	}

	.brand-tagline {
		font-size: 0.72rem;
		font-weight: 400;
		color: var(--muted);
		letter-spacing: -0.01em;
		white-space: nowrap;
		line-height: 1.2;
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 0;
		margin-left: auto;
	}

	.nav-links a {
		font-size: 0.875rem;
		color: var(--muted);
		padding: 0.45rem 0.95rem;
		border-radius: 999px;
		transition: color 0.12s ease;
		font-weight: 500;
		letter-spacing: -0.015em;
	}

	.nav-links a:hover {
		color: rgba(255, 255, 255, 0.88);
	}

	.nav-links a.active {
		color: var(--bright);
		background: var(--active-bg);
	}

	.invite {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		background: transparent;
		color: var(--bright);
		border: 1px solid rgba(255, 255, 255, 0.3);
		font-weight: 600;
		font-size: 0.875rem;
		padding: 0.55rem 1.1rem;
		border-radius: 999px;
		transition: background 0.12s ease, border-color 0.12s ease;
		white-space: nowrap;
		flex-shrink: 0;
		letter-spacing: -0.02em;
	}

	.invite:hover {
		background: rgba(255, 255, 255, 0.08);
		border-color: rgba(255, 255, 255, 0.5);
		color: var(--bright);
		text-decoration: none;
	}

	.invite svg {
		flex-shrink: 0;
	}
</style>

<script>
	(function() {
		const currentPath = window.location.pathname;
		const navLinks = document.querySelectorAll('.nav-links a');

		navLinks.forEach(link => {
			const href = link.getAttribute('href');
			const normalize = (str) => str.replace(/\/$/, '') || '/';
			if (normalize(href) === normalize(currentPath)) {
				link.classList.add('active');
			} else {
				link.classList.remove('active');
			}
		});
	})();
</script>