---
import "../styles/reset.astro";
import "../styles/global.astro";

import BgGrid from "../components/bg-grid.astro";
import Navigation from "../components/navigation.astro";
import Embed from "../components/embed.astro";
import Footer from "../components/footer.astro";

const roadmapPhases = [
	//{
	//	id: 1,
	//	quarter: "Q4 2024",
	//	dateRange: "October - December 2024",
	//	status: "completed",
	//	statusLabel: "Completed",
	//	features: [
	//		{
	//			title: "Core Message Logging",
	//			description: "Complete message history with timestamps and metadata"
	//		},
	//		{
	//			title: "Attachment & Embed Preservation",
	//			description: "Full capture of media and embedded content"
	//		},
	//		{
	//			title: "Encrypted Storage",
	//			description: "Military-grade encryption for all data at rest"
	//		}
	//	]
	//},
];

function getStatusIcon(status: string) {
	switch(status) {
		case "completed":
			return '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';
		case "in-progress":
			return '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"></circle><path d="M12 1v6m0 6v6"></path></svg>';
		case "planned":
			return '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"></path><path d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>';
		case "future":
			return '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path><polyline points="13 2 13 9 20 9"></polyline></svg>';
		default:
			return '';
	}
}

function getFeatureIcon() {
	return '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';
}
---
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Roadmap - Fox Box Insurance</title>
		<Embed />
	</head>
	<body>
		<div class="bg-grid-fixed">
			<BgGrid />
		</div>
		<Navigation />

		<section class="roadmap-hero">
			<div class="roadmap-hero-container">
				<h1 class="roadmap-hero-title">What we're building.</h1>
				<p class="roadmap-hero-description">
					See what's coming next for Fox Box Insurance. We're constantly building and improving to keep your Discord communities safe.
				</p>
			</div>
		</section>

		<div class="roadmap-section">
			<div class="roadmap-container">
				{roadmapPhases.length > 0 ? (
					<div class="roadmap-timeline">
						{roadmapPhases.map((phase, index) => (
							<div class="roadmap-phase" style={`animation-delay: ${(index + 1) * 0.1}s`}>
								<div class={`phase-header ${phase.status}`}>
									<div class="phase-status-badge">
										<Fragment set:html={getStatusIcon(phase.status)} />
										{phase.statusLabel}
									</div>
									<h2 class="phase-title">{phase.quarter}</h2>
									<p class="phase-date">{phase.dateRange}</p>
								</div>
								<div class="phase-features">
									{phase.features.map((feature) => (
										<div class={`feature-item ${phase.status}`}>
											<span class="feature-icon">
												<Fragment set:html={getFeatureIcon()} />
											</span>
											<div>
												<h3>{feature.title}</h3>
												<p>{feature.description}</p>
											</div>
										</div>
									))}
								</div>
							</div>
						))}
					</div>
				) : (
					<div class="empty-state">
						<svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path>
							<polyline points="13 2 13 9 20 9"></polyline>
						</svg>
						<h2>Nothing here yet</h2>
						<p>Nadaa - but check .</p>
					</div>
				)}
			</div>
		</div>

		<div class="roadmap-cta">
			<div class="roadmap-cta-container">
				<div class="roadmap-cta-box">
					<span class="cta-eyebrow">Community</span>
					<h2 class="roadmap-cta-title">Have an idea?</h2>
					<p class="roadmap-cta-description">
						Feature requests and feedback shape what we build next. Join our support server and tell us what you need.
					</p>
					<a href="/support" class="btn btn-primary">
						Join support server
					</a>
				</div>
			</div>
		</div>

		<Footer />

		<script>
			window.addEventListener('DOMContentLoaded', () => {
				const phases = document.querySelectorAll('.roadmap-phase');
				const observer = new IntersectionObserver((entries) => {
					entries.forEach(entry => {
						if (entry.isIntersecting) {
							entry.target.classList.add('visible');
						}
					});
				}, { threshold: 0.1 });

				phases.forEach(phase => observer.observe(phase));
			});
		</script>
	</body>
</html>

<style is:global>
	*, *::before, *::after {
		box-sizing: border-box;
	}

	:root {
		--ink: #0d0d10;
		--ember: #ff4800;
		--muted: rgba(255, 255, 255, 0.42);
		--dim: rgba(255, 255, 255, 0.16);
		--surface: rgba(255, 255, 255, 0.04);
		--surface-2: #141418;
		--line: rgba(255, 255, 255, 0.08);
		--line-ember: rgba(255, 72, 0, 0.18);
		--green: #10b981;
		--blue: #3b82f6;
	}

	.bg-grid-fixed {
		position: fixed;
		inset: 0;
		z-index: 0;
		pointer-events: none;
	}

	.bg-grid-fixed > * {
		position: absolute !important;
		inset: 0 !important;
		width: 100% !important;
		height: 100% !important;
	}

	body {
		position: relative;
		z-index: 1;
		font-family: system-ui, -apple-system, sans-serif;
	}

	/* ── Hero ── */

	.roadmap-hero {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 48vh;
		padding: 7rem 1.5rem 3.5rem;
		position: relative;
		z-index: 1;
		text-align: center;
	}

	.roadmap-hero-container {
		max-width: 640px;
		margin: 0 auto;
	}

	.hero-eyebrow {
		display: inline-block;
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--ember);
		margin-bottom: 0.875rem;
	}

	.roadmap-hero-title {
		font-size: clamp(2.25rem, 6vw, 3.5rem);
		font-weight: 800;
		letter-spacing: -0.05em;
		line-height: 1.05;
		color: #fff;
		margin: 0 0 1rem;
	}

	.roadmap-hero-description {
		color: var(--muted);
		font-size: 0.9375rem;
		line-height: 1.7;
		max-width: 480px;
		margin: 0 auto;
	}

	/* ── Timeline ── */

	.roadmap-section {
		padding: 0 1.5rem 6rem;
		position: relative;
		z-index: 1;
	}

	.roadmap-container {
		max-width: 860px;
		margin: 0 auto;
	}

	.roadmap-timeline {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	/* ── Empty state ── */

	.empty-state {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		padding: 4rem 2rem;
		background: var(--surface-2);
		border: 1px dashed rgba(255, 72, 0, 0.2);
		border-radius: 1rem;
		gap: 0;
	}

	.empty-state svg {
		color: rgba(255, 72, 0, 0.35);
		margin-bottom: 1.25rem;
	}

	.empty-state h2 {
		font-size: 1.125rem;
		font-weight: 700;
		letter-spacing: -0.03em;
		color: rgba(255, 255, 255, 0.8);
		margin: 0 0 0.375rem;
	}

	.empty-state p {
		color: var(--muted);
		font-size: 0.875rem;
		margin: 0;
	}

	/* ── Phase card ── */

	.roadmap-phase {
		background: var(--surface-2);
		border: 1px solid var(--line);
		border-radius: 1rem;
		padding: 1.75rem;
		opacity: 0;
		animation: fadeUp 0.5s ease forwards;
	}

	.roadmap-phase.visible {
		opacity: 1;
	}

	@keyframes fadeUp {
		from { opacity: 0; transform: translateY(16px); }
		to   { opacity: 1; transform: translateY(0); }
	}

	.roadmap-phase:nth-child(1) { animation-delay: 0.1s; }
	.roadmap-phase:nth-child(2) { animation-delay: 0.2s; }
	.roadmap-phase:nth-child(3) { animation-delay: 0.3s; }
	.roadmap-phase:nth-child(4) { animation-delay: 0.4s; }
	.roadmap-phase:nth-child(5) { animation-delay: 0.5s; }

	.phase-header {
		margin-bottom: 1.5rem;
		padding-bottom: 1.25rem;
		border-bottom: 1px solid var(--line);
	}

	.phase-status-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		font-size: 0.7rem;
		font-weight: 650;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		padding: 0.3rem 0.7rem;
		border-radius: 999px;
		margin-bottom: 0.875rem;
	}

	.phase-header.completed .phase-status-badge {
		background: rgba(16, 185, 129, 0.08);
		color: var(--green);
		border: 1px solid rgba(16, 185, 129, 0.18);
	}

	.phase-header.in-progress .phase-status-badge {
		background: rgba(255, 72, 0, 0.1);
		color: var(--ember);
		border: 1px solid rgba(255, 72, 0, 0.22);
	}

	.phase-header.planned .phase-status-badge {
		background: rgba(59, 130, 246, 0.08);
		color: var(--blue);
		border: 1px solid rgba(59, 130, 246, 0.18);
	}

	.phase-header.future .phase-status-badge {
		background: rgba(255, 255, 255, 0.05);
		color: var(--muted);
		border: 1px solid var(--line);
	}

	.phase-title {
		font-size: 1.5rem;
		font-weight: 800;
		letter-spacing: -0.04em;
		color: #fff;
		margin: 0 0 0.25rem;
	}

	.phase-date {
		color: var(--muted);
		font-size: 0.8125rem;
		margin: 0;
	}

	/* ── Feature items ── */

	.phase-features {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.feature-item {
		display: flex;
		gap: 0.875rem;
		align-items: flex-start;
		padding: 0.875rem 1rem;
		border-radius: 0.625rem;
		transition: background 0.12s ease;
	}

	.feature-item:hover {
		background: rgba(255, 255, 255, 0.04);
	}

	.feature-icon {
		flex-shrink: 0;
		margin-top: 0.125rem;
	}

	.feature-item.completed .feature-icon { color: var(--green); }
	.feature-item.in-progress .feature-icon { color: var(--ember); }
	.feature-item.planned .feature-icon { color: var(--blue); }
	.feature-item.future .feature-icon { color: var(--muted); }

	.feature-item h3 {
		font-size: 0.9rem;
		font-weight: 650;
		letter-spacing: -0.02em;
		color: #fff;
		margin: 0 0 0.2rem;
	}

	.feature-item p {
		color: var(--muted);
		font-size: 0.8125rem;
		line-height: 1.55;
		margin: 0;
	}

	/* ── CTA ── */

	.roadmap-cta {
		padding: 5rem 1.5rem 6rem;
		border-top: 1px solid var(--line);
		position: relative;
		z-index: 1;
	}

	.roadmap-cta-container {
		max-width: 860px;
		margin: 0 auto;
	}

	.roadmap-cta-box {
		background: var(--surface-2);
		border: 1px solid var(--line-ember);
		border-radius: 1rem;
		padding: 3rem 2rem;
		text-align: center;
		max-width: 520px;
		margin: 0 auto;
	}

	.cta-eyebrow {
		display: inline-block;
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--ember);
		margin-bottom: 0.75rem;
	}

	.roadmap-cta-title {
		font-size: 1.625rem;
		font-weight: 800;
		letter-spacing: -0.04em;
		color: #fff;
		margin: 0 0 0.75rem;
	}

	.roadmap-cta-description {
		color: var(--muted);
		font-size: 0.875rem;
		line-height: 1.7;
		margin: 0 0 1.75rem;
	}

	/* ── Shared button tokens ── */

	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-weight: 650;
		font-size: 0.825rem;
		padding: 0.55rem 1.25rem;
		border-radius: 999px;
		transition: background 0.12s ease, border-color 0.12s ease, color 0.12s ease;
		text-decoration: none;
		letter-spacing: -0.015em;
		font-family: system-ui, -apple-system, sans-serif;
	}

	.btn-primary {
		background: rgba(255, 255, 255, 0.96);
		color: var(--ink);
		border: 1px solid transparent;
	}

	.btn-primary:hover {
		background: rgba(255, 255, 255, 0.84);
	}

	/* ── Responsive ── */

	@media (max-width: 480px) {
		.roadmap-hero {
			padding: 6rem 1.25rem 2.5rem;
		}

		.roadmap-section {
			padding: 0 1.25rem 4rem;
		}

		.roadmap-phase {
			padding: 1.25rem;
		}

		.roadmap-cta-box {
			padding: 2rem 1.25rem;
		}
	}
</style>