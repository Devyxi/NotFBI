---
import "../styles/reset.astro";
import "../styles/global.astro";

import BgGrid from "../components/bg-grid.astro";
import Navigation from "../components/navigation.astro";
import Embed from "../components/embed.astro";
import Footer from "../components/footer.astro";
---
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>About - Fox Box Insurance</title>
		<Embed />
	</head>
	<body>

		<div class="bg-grid-fixed">
			<BgGrid />
		</div>
		<Navigation />

		<section class="about-hero">
			<div class="about-container">
				<h1 class="about-title">Built to remember<br><span class="about-accent">what others forget.</span></h1>
				<p class="about-lead">
					Fox Box Insurance started with a simple frustration: Discord servers losing everything the moment something went wrong.
					Deleted channels, nuked messages, rogue admins - and nothing to show for it. We built FBI to fix that.
				</p>
			</div>
		</section>

		<section class="story-section">
			<div class="about-container">
				<div class="story-grid">
					<div class="story-block">
						<h2 class="story-heading">Where it started</h2>
						<p>
							FBI was born out of necessity. A small Discord community lost months of conversations and history overnight -
							a single bad actor with admin access wiped everything. No logs. No backups. No way to recover.
						</p>
						<p>
							That shouldn't be possible. So we made sure it wouldn't happen again.
						</p>
					</div>
					<div class="story-block">
						<h2 class="story-heading">What we set out to do</h2>
						<p>
							We wanted a bot that worked silently - no commands to remember, no setup headaches, no dashboard you have to
							check every day. Just quiet, reliable protection running in the background while you focus on your community.
						</p>
						<p>
							Every message logged. Every attachment captured. Every change recorded. All of it there when you need it.
						</p>
					</div>
				</div>
			</div>
		</section>

		<section class="mission-section">
			<div class="about-container">
				<div class="mission-card">
					<div class="mission-icon-wrap">
						<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
						</svg>
					</div>
					<div class="mission-text">
						<h2 class="mission-heading">Our mission</h2>
						<p>
							No Discord community should lose its history. Whether you're running a gaming clan, a study group, or a
							business operation - your conversations, your culture, and your records deserve to be protected.
							FBI exists to make that protection effortless, private, and free.
						</p>
					</div>
				</div>
			</div>
		</section>

		<section class="values-section">
			<div class="about-container">
				<h2 class="values-title">What we believe in</h2>
				<div class="values-grid">
					<div class="value-card">
						<div class="value-icon-wrap">
							<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
								<path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
							</svg>
						</div>
						<h3 class="value-heading">Privacy first</h3>
						<p class="value-description">Your data is yours. We don't sell it, we don't share it, and we don't profit from it. Every feature is designed with your privacy as the baseline, not an afterthought.</p>
					</div>
					<div class="value-card">
						<div class="value-icon-wrap">
							<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<polyline points="20 6 9 17 4 12"></polyline>
							</svg>
						</div>
						<h3 class="value-heading">Simple by default</h3>
						<p class="value-description">Good protection shouldn't require a manual. Invite the bot and it works. No configuration required, no learning curve, no friction between you and a safer server.</p>
					</div>
					<div class="value-card">
						<div class="value-icon-wrap">
							<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M12 2L2 7l10 5 10-5-10-5z"></path>
								<path d="M2 17l10 5 10-5"></path>
								<path d="M2 12l10 5 10-5"></path>
							</svg>
						</div>
						<h3 class="value-heading">Open and honest</h3>
						<p class="value-description">We're transparent about what we collect, how we store it, and what we do with it. Our backend is open, our policies are plain English, and we don't hide behind legal blur.</p>
					</div>
					<div class="value-card">
						<div class="value-icon-wrap">
							<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
								<circle cx="9" cy="7" r="4"></circle>
								<path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
								<path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
							</svg>
						</div>
						<h3 class="value-heading">Community driven</h3>
						<p class="value-description">FBI is shaped by the people who use it. Every feature request, bug report, and piece of feedback from our community has made the bot what it is today.</p>
					</div>
				</div>
			</div>
		</section>

		<div class="cta-section">
			<div class="cta-container">
				<div class="cta-inner">
					<h2 class="cta-title">Ready to protect your server?</h2>
					<p class="cta-description">
						Adding FBI to your server takes seconds. No setup, no cost, no compromise.
					</p>
					<div class="cta-actions">
						<a href="/invite" class="cta-button-primary">Add to Discord</a>
						<a href="/support" class="cta-button-ghost">Join the community</a>
					</div>
				</div>
			</div>
		</div>

		<Footer />

	</body>
</html>

<style is:global>
	*, *::before, *::after {
		box-sizing: border-box;
	}

	.bg-grid-fixed {
		position: fixed;
		inset: 0;
		z-index: 0;
		pointer-events: none;
	}

	.bg-grid-fixed > * {
		position: absolute !important;
		inset: 0 !important;
		width: 100% !important;
		height: 100% !important;
	}

	body {
		position: relative;
		z-index: 1;
	}

	.about-container {
		max-width: 1152px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	.about-hero {
		min-height: 50vh;
		display: flex;
		align-items: center;
		padding: 10rem 1.5rem 5rem;
		position: relative;
		z-index: 1;
	}

	.about-title {
		font-size: 2.25rem;
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 1.08;
		margin-bottom: 1.5rem;
		max-width: 640px;
	}

	.about-accent {
		color: var(--color-primary, #ff4800);
	}

	.about-lead {
		font-size: 1rem;
		color: rgba(255, 255, 255, 0.55);
		line-height: 1.8;
		max-width: 560px;
		font-weight: 500;
		letter-spacing: -0.01em;
	}

	.story-section {
		padding: 5rem 1.5rem;
		border-top: 1px solid rgba(255, 255, 255, 0.06);
		position: relative;
		z-index: 1;
	}

	.story-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 3rem;
	}

	.story-block h2 {
		font-size: 1.25rem;
		font-weight: 700;
		letter-spacing: -0.03em;
		margin-bottom: 1rem;
		color: #fff;
	}

	.story-block p {
		font-size: 0.9rem;
		color: rgba(255, 255, 255, 0.55);
		line-height: 1.8;
		font-weight: 500;
		letter-spacing: -0.01em;
		margin-bottom: 0.75rem;
	}

	.story-block p:last-child {
		margin-bottom: 0;
	}

	.mission-section {
		padding: 2rem 1.5rem 5rem;
		position: relative;
		z-index: 1;
	}

	.mission-card {
		background: #141418;
		border: 1px solid rgba(255, 72, 0, 0.18);
		border-radius: 1.25rem;
		padding: 2.5rem;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.mission-icon-wrap {
		width: 48px;
		height: 48px;
		background: rgba(255, 72, 0, 0.1);
		border: 1px solid rgba(255, 72, 0, 0.2);
		border-radius: 0.75rem;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--color-primary, #ff4800);
		flex-shrink: 0;
	}

	.mission-heading {
		font-size: 1.25rem;
		font-weight: 700;
		letter-spacing: -0.03em;
		margin-bottom: 0.75rem;
		color: #fff;
	}

	.mission-text p {
		font-size: 0.9rem;
		color: rgba(255, 255, 255, 0.55);
		line-height: 1.8;
		font-weight: 500;
		letter-spacing: -0.01em;
	}

	.values-section {
		padding: 5rem 1.5rem;
		border-top: 1px solid rgba(255, 255, 255, 0.06);
		position: relative;
		z-index: 1;
	}

	.values-title {
		font-size: 2rem;
		font-weight: 800;
		letter-spacing: -0.04em;
		margin-bottom: 2rem;
	}

	.values-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.75rem;
	}

	.value-card {
		background: #141418;
		border: 1px solid rgba(255, 255, 255, 0.06);
		border-radius: 1rem;
		padding: 1.75rem;
		transition: border-color 0.2s ease;
	}

	.value-card:hover {
		border-color: rgba(255, 72, 0, 0.22);
	}

	.value-icon-wrap {
		width: 36px;
		height: 36px;
		background: rgba(255, 72, 0, 0.1);
		border: 1px solid rgba(255, 72, 0, 0.18);
		border-radius: 0.625rem;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--color-primary, #ff4800);
		margin-bottom: 1rem;
	}

	.value-heading {
		font-size: 0.95rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		margin-bottom: 0.5rem;
		color: #fff;
	}

	.value-description {
		font-size: 0.85rem;
		color: rgba(255, 255, 255, 0.55);
		line-height: 1.75;
		font-weight: 500;
		letter-spacing: -0.01em;
	}

	.cta-section {
		padding: 5rem 1.5rem;
		position: relative;
		z-index: 1;
	}

	.cta-container {
		max-width: 1152px;
		margin: 0 auto;
	}

	.cta-inner {
		border: 1px solid rgba(255, 72, 0, 0.18);
		background: #171410;
		border-radius: 1.5rem;
		padding: 4rem 2rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		max-width: 560px;
		margin: 0 auto;
	}

	.cta-title {
		font-size: 1.65rem;
		font-weight: 800;
		letter-spacing: -0.04em;
		margin-bottom: 0.75rem;
		line-height: 1.15;
	}

	.cta-description {
		color: rgba(255, 255, 255, 0.55);
		margin-bottom: 2rem;
		line-height: 1.75;
		font-size: 0.875rem;
		font-weight: 500;
		letter-spacing: -0.01em;
	}

	.cta-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.625rem;
		justify-content: center;
	}

	.cta-button-primary {
		display: inline-flex;
		align-items: center;
		background: rgba(255, 72, 0, 0.15);
		border: 1px solid rgba(255, 72, 0, 0.45);
		color: #fff;
		font-weight: 600;
		font-size: 0.85rem;
		padding: 0.65rem 1.75rem;
		border-radius: 999px;
		text-decoration: none;
		transition: all 0.15s ease;
		letter-spacing: -0.01em;
	}

	.cta-button-primary:hover {
		background: rgba(255, 72, 0, 0.25);
		border-color: rgba(255, 72, 0, 0.75);
	}

	.cta-button-ghost {
		display: inline-flex;
		align-items: center;
		background: transparent;
		border: 1px solid rgba(255, 255, 255, 0.1);
		color: rgba(255, 255, 255, 0.55);
		font-weight: 600;
		font-size: 0.85rem;
		padding: 0.65rem 1.75rem;
		border-radius: 999px;
		text-decoration: none;
		transition: all 0.15s ease;
		letter-spacing: -0.01em;
	}

	.cta-button-ghost:hover {
		background: rgba(255, 255, 255, 0.06);
		border-color: rgba(255, 255, 255, 0.2);
		color: #fff;
	}

	@media (min-width: 640px) {
		.about-title { font-size: 3rem; }
		.about-lead { font-size: 1.05rem; }
		.values-grid { grid-template-columns: repeat(2, 1fr); }
		.values-title { font-size: 2.5rem; }
	}

	@media (min-width: 768px) {
		.story-grid { grid-template-columns: repeat(2, 1fr); }
		.mission-card { flex-direction: row; align-items: flex-start; }
	}

	@media (min-width: 1024px) {
		.about-title { font-size: 3.75rem; }
		.values-title { font-size: 2.75rem; }
	}
</style>
---