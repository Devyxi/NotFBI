---
import "../styles/reset.astro";
import "../styles/global.astro";

import BgGrid from "../components/bg-grid.astro";
import Navigation from "../components/navigation.astro";
import Embed from "../components/embed.astro";
import Footer from "../components/footer.astro";

const { title, date } = Astro.props.frontmatter;
---
<html lang="en">
	<head>
		<meta charset="UTF-8">		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>{title}</title>
		<Embed />
	</head>
	<body>
		<BgGrid />
		<Navigation />

		<div class="content">

			<h1>{title}</h1>
			<p>{date}</p>

			<slot />
		</div>

		<Footer />
	</body>
    <style>
		.content :global(h1) {
			font-size: 2.5rem;
			font-weight: bold;
			color: #fff;
			margin-top: 1.5rem;
			margin-bottom: 1.5rem;
		}

		.content :global(h2) {
			margin-top: 3rem;
			margin-bottom: 1rem;
			font-size: 1.5rem;
			font-weight: bold;
			color: var(--color-primary);
		}

		.content :global(h3) {
			margin-bottom: 0.5rem;
			font-size: 1.3rem;
			font-weight: bold;
			color: var(--color-primary);
		}

		.content :global(p) {
			margin-bottom: 0.5rem;
		}

		.content :global(ul) {
			margin-bottom: 1rem;
			margin-left: 1rem;
		}

		.content :global(li) {
			margin-bottom: 0.5rem;
			margin-left: 1.5rem;
			list-style-type: disc;
			padding-left: 1.5rem;
		}

		.content :global(th, td) {
			border-bottom: 1px solid rgba(255, 255, 255, 0.2);
			padding: 1rem;
		}

		.content :global(table) {
			width: 100%;
			border-collapse: collapse;
			margin-bottom: 1rem;
		}
    </style>
</html>